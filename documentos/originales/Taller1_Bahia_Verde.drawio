<mxCell id="attr1200" value="&lt;span style='text-decoration:underline;text-decoration-style:dashed;'&gt;direccion&lt;/span&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="900" y="230" width="120" height="40" as="geometry"/></mxCell>
<mxCell id="edge1201" value="" style="edgeStyle=none;html=1;endArrow=none;startArrow=none;fontSize=11;" edge="1" parent="1" source="attr1200" target="ent1186"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="note1202" value="Ej. 1b - sede (multivaluado Y compuesto). Orden correcto: 1) tratar como MULTIVALUADO -&gt; nueva entidad debil SEDE_CONTRATISTA; 2) dentro de esa entidad, descomponer el atributo COMPUESTO en ciudad y direccion (simples)." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#000000;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="60" y="30" width="1100" height="30" as="geometry"/></mxCell>
<mxCell id="note1203" value="Orden inverso (primero componer): si se descompone sede en ciudad/direccion directamente sobre CONTRATISTA y luego se 
multivalua cada uno por separado, se pierde la pareja ciudad-direccion de cada sede (dos multivaluados independientes 
ya no permiten saber que direccion corresponde a que ciudad). El modelo deja de ser equivalente." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#000000;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="60" y="340" width="1000" height="70" as="geometry"/></mxCell>
    </root>
  </mxGraphModel>
</diagram>
