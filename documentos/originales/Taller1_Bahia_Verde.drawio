<mxCell id="attr1316" value="&lt;span style='text-decoration:underline;text-decoration-style:dashed;'&gt;equipo&lt;/span&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1000" y="690" width="120" height="40" as="geometry"/></mxCell>
<mxCell id="edge1317" value="" style="edgeStyle=none;html=1;endArrow=none;startArrow=none;fontSize=11;" edge="1" parent="1" source="attr1316" target="ent1290"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="note1318" value="Ej. 4a - Jerarquia PARCIAL y SOLAPADA: OPERARIO participa de forma parcial en cada relacion ES_UN (no todo operario es gruero o estibador), y ambas relaciones pueden estar activas para el mismo operario a la vez (solapamiento) -- por eso GRUERO y ESTIBADOR quedan como entidades separadas relacionadas 1:1 con OPERARIO, cada una con participacion TOTAL de su lado (todo GRUERO/ESTIBADOR es siempre un OPERARIO)." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#000000;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="60" y="20" width="1300" height="60" as="geometry"/></mxCell>
<mxCell id="note1319" value="Estrategia DESCARTADA: colapsar todo en una sola tabla OPERARIO con un atributo discriminador de tipo (unico flag gruero/estibador). No sirve porque, al ser SOLAPADA, un mismo operario puede ser gruero Y estibador simultaneamente, y un solo atributo de tipo no puede representar dos valores a la vez." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#000000;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="60" y="780" width="1300" height="50" as="geometry"/></mxCell>
<mxCell id="note1320" value="equipos_manejados (multivaluado de ESTIBADOR) se transforma igual que un atributo multivaluado: nueva entidad debil EQUIPO_MANEJADO." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#000000;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="60" y="850" width="1300" height="30" as="geometry"/></mxCell>
    </root>
  </mxGraphModel>
</diagram>
