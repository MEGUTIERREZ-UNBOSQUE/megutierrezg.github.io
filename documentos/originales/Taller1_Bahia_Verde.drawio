<mxCell id="entI1279" value="EMBARQUE" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="205" y="225" width="180" height="50" as="geometry"/></mxCell>
